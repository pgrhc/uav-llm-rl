
# REQUEST (Girdiler)
string system_summary_json   # Hız, konum, tehditler (JSON formatında)
string mission_goal          # "Hedefe güvenli git" vb.
string constraints           # "Maksimum hız 2.0, uçuşa yasak bölge var"

